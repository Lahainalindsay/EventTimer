NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_active_browser_key

# Optional deployment label and project-ref guards. One-project private beta
# deployments only need the three required variables above and below.
# NEXT_PUBLIC_EVENT_TIMER_ENV=production
# NEXT_PUBLIC_SUPABASE_PRODUCTION_REF=your-project-ref

# Server-only. Prefer SUPABASE_SECRET_KEY; the legacy service-role name is a fallback.
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key
